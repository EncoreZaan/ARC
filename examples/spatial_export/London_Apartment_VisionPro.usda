#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1.0
    upAxis = "Z"
    doc = "ARC Spatial USD Exporter for Apple Vision Pro & visionOS"
)

def Xform "Root" (
    assetInfo = { string name = "ArchitecturalSpatialScene" }
)
{
    def Cube "WALL_EXT_01" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double3 xformOp:translate = (4.000, 0.150, 1.400)
        float3 xformOp:scale = (4.000, 0.150, 1.400)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        custom string category = "Walls"
        custom bool apple:visionPro:interactive = true
    }

    def Cube "FLOOR_SLAB_01" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double3 xformOp:translate = (4.000, 3.000, -0.125)
        float3 xformOp:scale = (4.000, 3.000, 0.125)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        custom string category = "Floors"
        custom bool apple:visionPro:interactive = true
    }

    def Cube "WINDOW_BAY_01" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double3 xformOp:translate = (4.000, 0.150, 1.200)
        float3 xformOp:scale = (1.500, 0.100, 1.200)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        custom string category = "Windows"
        custom bool apple:visionPro:interactive = true
    }

}
