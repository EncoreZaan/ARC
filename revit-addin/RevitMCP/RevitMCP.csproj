<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>RevitMCP</AssemblyName>
    <RootNamespace>RevitMCP</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <Version>2.9.0</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2027</RevitVersion>
    <RevitInstallDir Condition="Exists('C:\Program Files\Autodesk\Revit 2027')">C:\Program Files\Autodesk\Revit 2027</RevitInstallDir>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == '' and Exists('C:\Program Files\Autodesk\Revit 2026')">C:\Program Files\Autodesk\Revit 2026</RevitInstallDir>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == '' and Exists('C:\Program Files\Autodesk\Revit 2025')">C:\Program Files\Autodesk\Revit 2025</RevitInstallDir>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <Target Name="CopyToRevitAddins" AfterTargets="Build" Condition="'$(DeployAddin)' != 'false'">
    <PropertyGroup>
      <RevitAddinsDir>$(APPDATA)\Autodesk\Revit\Addins\$(RevitVersion)\</RevitAddinsDir>
    </PropertyGroup>
    <Message Importance="High" Text="Deploying addin to $(RevitAddinsDir)" />
    <MakeDir Directories="$(RevitAddinsDir)" />
    <ItemGroup>
      <OutputAssemblies Include="$(TargetDir)*.dll" />
      <OutputPdbs Include="$(TargetDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(OutputAssemblies)" DestinationFolder="$(RevitAddinsDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="@(OutputPdbs)" DestinationFolder="$(RevitAddinsDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="$(ProjectDir)RevitMCP.addin" DestinationFolder="$(RevitAddinsDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
